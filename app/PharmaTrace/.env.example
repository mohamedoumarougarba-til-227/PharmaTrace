# ════════════════════════════════════════════════════
#  PharmaTrace — Variables d'environnement
#  Copiez ce fichier en .env et remplissez les valeurs
#  cp .env.example .env
# ════════════════════════════════════════════════════

# URL de votre projet Supabase
# Trouvez-la dans : Dashboard Supabase → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://example.invalid

# Clé publique anonyme Supabase (anon key — safe côté client)
# Trouvez-la dans : Dashboard Supabase → Settings → API → Project API keys
EXPO_PUBLIC_SUPABASE_ANON_KEY=local-demo-placeholder-not-a-credential

# Démo en mémoire : conserver ces valeurs fictives et choisir un bouton Démo.
# Mode réel : remplacer par VOTRE projet isolé et sa clé publique legacy anon.
# Jamais le MVP du propriétaire, ni une clé service_role/secrète.
