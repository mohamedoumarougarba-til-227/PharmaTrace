# ════════════════════════════════════════════════════
#  PharmaTrace — Variables d'environnement
#  Copiez ce fichier en .env et remplissez les valeurs
#  cp .env.example .env
# ════════════════════════════════════════════════════

# URL de votre projet Supabase
# Trouvez-la dans : Dashboard Supabase → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://votre-ref-projet.supabase.co

# Clé publique anonyme Supabase (anon key — safe côté client)
# Trouvez-la dans : Dashboard Supabase → Settings → API → Project API keys
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre-anon-key-ici
