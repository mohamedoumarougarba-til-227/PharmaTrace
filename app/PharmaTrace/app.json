{
  "expo": {
    "name": "PharmaTrace",
    "slug": "pharmatrace",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pharmatrace",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trustgrid.pharmatrace"
    },
    "android": {
      "package": "com.trustgrid.pharmatrace",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "PharmaTrace a besoin d'accéder à votre caméra pour scanner les QR codes des médicaments."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5af4da9e-fc02-455d-94d8-5a8eca6e3a11"
      }
    },
    "owner": "med2568"
  }
}
